<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Order is load-bearing: F# compiles top-to-bottom in a single pass.
      When adding a part of speech, insert its Model/X.fs above AnalysedWord.fs
      (the closed DU can only reference types already declared) and its
      Parsing/X.fs below Jsonl.fs.
    -->
    <Compile Include="Model\Morphology.fs" />      <!-- no deps                            -->             <!-- -> Grammatical                     -->     <!-- -> every Model/*                   -->
    <Compile Include="Wiktionary/Word.fs" />        <!-- no deps                            -->
    <Compile Include="Wiktionary/Jsonl.fs" />       <!-- -> Word                            -->
    <Compile Include="Parsing\Utils.fs" />
    <Compile Include="Parsing\Verb.fs" />
    <Compile Include="Parsing\Adjective.fs" />
    <Compile Include="Parsing\Article.fs" />
    <Compile Include="Parsing/Noun.fs" />           <!-- -> Model/* + Wiktionary/*          -->
    <Compile Include="Parsing\Determiner.fs" />
    <Compile Include="Parsing\Adverb.fs" />
    <Compile Include="Parsing\Pronoun.fs" />
    <Compile Include="Parsing\Preposition.fs" />
    <Compile Include="Parsing\Conjunction.fs" />
    <Compile Include="Parsing\Interjection.fs" />
    <Compile Include="Parsing\Particle.fs" />
    <Compile Include="Parsing\Numeral.fs" />
    <Compile Include="Parsing\ProperNoun.fs" />
    <Compile Include="Parsing\Text.fs" />
    <Compile Include="Service.fs" />                <!-- -> everything                      -->
    <Compile Include="Api.fs" />
    <Compile Include="Interop\Dto.fs" />
    <Compile Include="Interop\Convert.fs" />
    <Compile Include="Interop\Json.fs" />
    <Compile Include="Interop\Api.fs" />
    <None Include="scratch.fsx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\*.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Collections.ParallelSeq" Version="1.2.0" />
    <PackageReference Update="FSharp.Core" Version="11.0.101-rc2.26504.105" />
  </ItemGroup>

</Project>